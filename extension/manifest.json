{
  "manifest_version": 3,
  "name": "MiniLyrics Music Integration",
  "version": "1.1.0",
  "description": "Syncs playback status from Spotify, YouTube, YouTube Music, and Amazon Music to MiniLyrics desktop overlay via WebSocket.",
  "browser_specific_settings": {
    "gecko": {
      "id": "minilyrics@local",
      "strict_min_version": "109.0"
    }
  },
  "host_permissions": [
    "*://open.spotify.com/*",
    "*://*.youtube.com/*",
    "*://music.amazon.com/*",
    "*://music.amazon.co.uk/*",
    "*://music.amazon.de/*",
    "*://music.amazon.es/*",
    "*://music.amazon.fr/*",
    "*://music.amazon.it/*",
    "*://music.amazon.co.jp/*",
    "*://music.amazon.ca/*",
    "*://music.amazon.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://open.spotify.com/*",
        "*://*.youtube.com/*",
        "*://music.amazon.com/*",
        "*://music.amazon.co.uk/*",
        "*://music.amazon.de/*",
        "*://music.amazon.es/*",
        "*://music.amazon.fr/*",
        "*://music.amazon.it/*",
        "*://music.amazon.co.jp/*",
        "*://music.amazon.ca/*",
        "*://music.amazon.in/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
